        <name>Course End date Validation</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {

    if (isLoading || newValue == '')
        return;

    var startDate = g_form.getValue('u_course_start_date');

    if (startDate == '')
        return;

    var sDate = new Date(startDate);
    var eDate = new Date(newValue);

    if (eDate <= sDate) {
        g_form.showFieldMsg('u_course_end_date',
            'Course End Date must be greater than Course Start Date.',
            'error');
        g_form.clearValue('u_course_end_date');
    }
}]]></script>
