    // Total Cost field ki value lo
    var total = parseFloat(g_form.getValue('u_total_cost')) || 0;

    if (total > 2500) {

        g_form.setValue('u_l2_required', 'yes');
        g_form.setReadOnly('u_l2_required', true);

        g_form.setMandatory('u_management_l2', true);
        g_form.setReadOnly('u_management_l2', false);

    } else {

        g_form.setValue('u_l2_required', 'no');
        g_form.setReadOnly('u_l2_required', true);

        g_form.setMandatory('u_management_l2', false);
        g_form.clearValue('u_management_l2');
        g_form.setReadOnly('u_management_l2', false);

    }
}]]></script>
